{
  "manifest_version": 3,
  "name": "QVault — Coffre-fort local",
  "short_name": "QVault",
  "description": "Remplissez et enregistrez vos identifiants depuis votre coffre-fort QVault.",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Ouvrir QVault",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://qvault.hqmerchant.xyz/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/autosave.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
